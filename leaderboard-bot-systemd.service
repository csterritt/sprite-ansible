# /etc/systemd/system/leaderboard-bot.service
[Unit]
Description=Leaderboard Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/scripts/start-leaderboard-bot.sh
WorkingDirectory=/home/ubuntu/scripts
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
